# Copy this file to .env and fill in your own values. .env is gitignored and must never be committed.
# Get a free key instantly at https://api.nasa.gov (no key required to sign up beyond an email address).

# Required for real usage. DEMO_KEY works but is rate limited (~30 requests/hour, shared globally),
# so it is usually already exhausted. Falls back to DEMO_KEY if unset.
NASA_API_KEY=

# Optional overrides, same names as appsettings.json. Leave unset to use the defaults.
# Nasa__Rover=curiosity
# Nasa__MaxPhotosPerDate=5
# Storage__RootPath=photos
# Input__DatesFilePath=dates.txt
