# Build output, rebuilt inside the image
**/bin/
**/obj/
artifacts/
[Dd]ebug/
[Rr]elease/

# Source control and CI metadata
.git/
.gitignore
.github/

# Downloaded rover images are runtime data, they belong on a volume
photos/
**/photos/

# Local secrets and overrides, never copied into an image
appsettings.Local.json
**/appsettings.Local.json
*.env
.env
secrets.json

# Editor and tooling noise
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store

# Container and docs files that do not affect the build
Dockerfile
.dockerignore
docker-compose*.yml
*.md
